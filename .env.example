# Copy to `.env` and fill in from the Supabase dashboard
# (Project Settings -> API). `.env` is gitignored.

# --- Client-visible. VITE_* is inlined into the browser bundle at build time,
# so NOTHING secret may ever go in one of these. ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"

# --- Server-only. Read through process.env, never from client code. ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"
# Bypasses RLS. Used only by webhooks and cron jobs — never in a request served
# on behalf of a signed-in user.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# --- Demo account. Leave either one empty and the guest button does not
# appear at all — the sign-in screen asks the server, so there is no separate
# flag to keep in sync. ---
# A real Supabase user whose password lives only here. Anyone who clicks the
# guest button becomes this user, so what they can see and do is whatever its
# `org_members` row says — `viewer` for a read-only tour.
#
# It must only ever be a member of a league that exists to be demonstrated.
# A guest in a real client's organization can read every player's email, phone
# and date of birth, because a member of a league is allowed to.
GUEST_EMAIL=""
GUEST_PASSWORD=""
